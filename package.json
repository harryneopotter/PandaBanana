    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@netlify/functions": "^2.4.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/gif.js": "^0.2.5",
    "@types/node": "^22.14.0",
    "@vercel/node": "^3.0.11",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
