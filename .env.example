# ===================================
# Gemini API Configuration
# ===================================
GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# Deployment Mode Configuration
# ===================================
# Set VITE_USE_API_PROXY based on your deployment:
# - true: Use backend proxy (Vercel/Netlify serverless OR Express server)
# - false: Direct API calls from browser (not recommended for production)
VITE_USE_API_PROXY=true

# API URL (adjust based on deployment):
# - Local Express: http://localhost:3001
# - Vercel: https://your-app.vercel.app
# - Netlify: https://your-app.netlify.app
VITE_API_URL=http://localhost:3001

# ===================================
# Express Server Configuration (Local/Traditional Hosting)
# ===================================
PORT=3001

# ===================================
# Rate Limiting Configuration
# ===================================
# Time window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per time window (default: 10)
RATE_LIMIT_MAX_REQUESTS=10

# Whitelisted IPs (comma-separated, bypass rate limiting)
# Example: WHITELISTED_IPS=127.0.0.1,192.168.1.100,10.0.0.5
# Note: On serverless (Vercel/Netlify), these reset on cold starts
WHITELISTED_IPS=

# ===================================
# Deployment Notes
# ===================================
# For Vercel/Netlify:
#   - Set GEMINI_API_KEY in platform environment variables
#   - Set VITE_USE_API_PROXY=true
#   - Set VITE_API_URL to your deployed URL
#   - Serverless functions handle rate limiting automatically
#   - See DEPLOYMENT.md for detailed instructions
#
# For Railway/Render/Fly.io (Express server):
#   - Set all above variables in platform environment
#   - Use 'npm run start:server' as start command
#   - Consider adding Redis for persistent rate limiting
#   - See RATE_LIMITING.md for advanced configuration
